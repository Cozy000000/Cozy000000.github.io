{
  "name": "zhiyi-chen-homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "content": "node scripts/generate-content.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "npm run content && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/content.test.mjs",
    "test:static": "node --test tests/static.test.mjs",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "framer-motion": "12.25.0",
    "katex": "0.16.22",
    "lucide-react": "0.344.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "motion-dom": "12.24.11",
    "motion-utils": "12.24.10"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@eslint/js": "9.39.1",
    "@types/node": "22.15.30",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "gray-matter": "4.0.3",
    "highlight.js": "11.11.1",
    "js-yaml": "4.1.1",
    "marked": "15.0.12",
    "postcss": "8.5.6",
    "sanitize-html": "2.17.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0",
    "vite": "7.3.1"
  }
}
